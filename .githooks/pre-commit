#!/bin/sh
set -eu
for python in python python3 py; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
        exec "$python" .githooks/pre_commit.py
    fi
done
echo 'Pre-commit requires Python 3.10+ on PATH.' >&2
exit 1
