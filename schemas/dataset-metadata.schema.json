{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nordicintel/nordicintel-schemas/v2.0.0/schemas/dataset-metadata.schema.json",
  "title": "Dataset metadata",
  "type": "object",
  "properties": {
    "identity": {
      "$ref": "dataset.schema.json#/$defs/identity"
    },
    "id": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dimension": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "extensions/px.schema.json#/$defs/dimensionValue"
      }
    },
    "role": {
      "$ref": "common/jsonstat.schema.json#/$defs/role"
    },
    "note": {
      "$ref": "common/jsonstat.schema.json#/$defs/note"
    },
    "link": {
      "$ref": "common/jsonstat.schema.json#/$defs/link"
    },
    "metadata_url": {
      "$ref": "dataset.schema.json#/$defs/url"
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "\\S"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "config"
      ],
      "additionalProperties": false
    },
    "extension": {
      "$ref": "extensions/px.schema.json"
    }
  },
  "required": [
    "identity",
    "id",
    "dimension"
  ],
  "additionalProperties": false
}
